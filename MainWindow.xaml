<Window x:Class="AiWebGateway.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="AI Web Gateway" Height="0" Width="0"
        WindowStyle="None" ShowInTaskbar="False">
    <tb:TaskbarIcon x:Name="TrayIcon"
                ToolTipText="AI Web Gateway"
                TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
        <tb:TaskbarIcon.IconSource>
            <BitmapImage UriSource="pack://application:,,,/Resources/icon.ico"/>
        </tb:TaskbarIcon.IconSource>
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="ToggleMenuItem" Header="启动服务" Click="ToggleService_Click"/>
                <Separator/>
                <MenuItem Header="聊天..." Click="OpenChat_Click"/>
                <MenuItem Header="API 信息..." Click="OpenApiInfo_Click"/>
                <Separator/>
                <MenuItem Header="配置..." Click="OpenSettings_Click"/>
                <MenuItem Header="查看日志" Click="OpenLogs_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="ExitApp_Click"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
</Window>